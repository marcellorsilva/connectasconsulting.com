---
import { ClientRouter } from "astro:transitions";
import { COMPANY, IMG, PHOTO } from "../company";
import { SERVICES } from "../lib/services";
import { ICON } from "../lib/icons";
import { ROUTES, SITE, INSIGHTS_ON, serviceUrl, type Lang, type PageKey } from "../lib/routes";
import CookieNotice from "../components/CookieNotice.astro";
import Flag from "../components/Flag.astro";

interface Props { lang: Lang; title: string; description: string; page: PageKey; alt?: { EN: string; PT: string }; dark?: boolean }
const { lang, title, description, page, alt, dark = false } = Astro.props;
const pt = lang === "PT";
const L = (en: string, p: string) => (pt ? p : en);
const R = ROUTES[lang];
const here = { EN: alt?.EN ?? ROUTES.EN[page], PT: alt?.PT ?? ROUTES.PT[page] };
const nav: [string, string, PageKey[]][] = [
  [L("Solutions", "Soluções"), R.solutions, ["solutions"]],
  [L("Countries", "Países"), R.usa, ["usa", "brazil", "guyana"]],
  [L("Technology", "Tecnologia"), R.technology, ["technology"]],
  ...(INSIGHTS_ON ? [[L("Market Insights", "Insights"), R.insights, ["insights"]] as [string, string, PageKey[]]] : []),
  [L("About", "Sobre"), R.about, ["about"]],
];
const countries: [string, string][] = [[L("United States", "Estados Unidos"), R.usa], [L("Brazil", "Brasil"), R.brazil], [L("Guyana", "Guiana"), R.guyana]];
// Mega menu (Solutions): one short line per service
const MENU_SHORT: Record<string, [string, string]> = {
  "business-plans": ["Investor-ready plans for each country", "Planos prontos para investidores"],
  registration: ["Company formation, licences, tax IDs", "Abertura, licenças e cadastros"],
  "market-entry": ["Studies, positioning, introductions", "Estudos, posicionamento, apresentações"],
  relocation: ["Homes, schools, settling-in", "Moradia, escolas e adaptação"],
  technology: ["Websites, systems, iOS & Android apps", "Sites, sistemas e apps iOS e Android"],
  marketing: ["Brand, digital and launch campaigns", "Marca, digital e campanhas de lançamento"],
  support: ["On-the-ground coordination", "Coordenação no dia a dia"],
};
const flags: Record<string, "GY" | "BR" | "US"> = { [R.guyana]: "GY", [R.brazil]: "BR", [R.usa]: "US" };
const year = 2026;
---
<!doctype html>
<html lang={pt ? "pt-BR" : "en"}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={SITE + here[lang]} />
  <link rel="alternate" hreflang="en" href={SITE + here.EN} />
  <link rel="alternate" hreflang="pt-BR" href={SITE + here.PT} />
  <link rel="alternate" hreflang="x-default" href={SITE + here.EN} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={IMG.logo} />
  <meta name="theme-color" content="#0A0A0A" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;1,9..144,300&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/site.css" />
  <ClientRouter fallback="swap" />
</head>
<body class={dark ? "page-dark" : ""}>
  <a class="skip" href="#main">{L("Skip to content", "Ir para o conteúdo")}</a>
  <header class="top" transition:name="top" transition:animate="none">
    <div class="wrap top-in">
      <a class="logo" href={R.home} aria-label={L("Connectas home", "Página inicial da Connectas")}><img src={IMG.logo} alt="Connectas" width="150" height="40" /></a>
      <nav class="nav" aria-label={L("Main", "Principal")}>
        {nav.map(([t, u, keys]) => keys[0] === "solutions"
          ? <div class="has-mega"><a href={u} class:list={["nl", { on: keys.includes(page) }]}>{t}<svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" /></svg></a>
              <div class="mega">
                <div class="mega-col">
                  <span class="mega-h">{L("By service", "Por serviço")}</span>
                  <div class="mega-grid">{SERVICES.map((sv) => <a href={serviceUrl(lang, sv.key)} class="mega-item"><span class="mega-ic" set:html={ICON[sv.icon]} /><span><b>{sv.title[lang]}</b><small>{MENU_SHORT[sv.key][pt ? 1 : 0]}</small></span></a>)}</div>
                </div>
                <div class="mega-col">
                  <span class="mega-h">{L("By market", "Por mercado")}</span>
                  {countries.map(([c, cu]) => <a href={cu} class="mega-link"><span class="mega-code">{flags[cu]}</span>{c}</a>)}
                  <span class="mega-h" style="margin-top:22px">{L("Technology", "Tecnologia")}</span>
                  <a href={R.technology} class="mega-link">{L("Websites", "Sites")}</a>
                  <a href={R.technology} class="mega-link">{L("Management systems", "Sistemas de gestão")}</a>
                  <a href={R.technology} class="mega-link">{L("iOS & Android apps", "Apps iOS e Android")}</a>
                  <a href={R.technology} class="mega-link">{L("White-label platform", "Plataforma white label")}</a>
                </div>
                <a href={R.technology} class="mega-feature">
                  <span class="mega-img"><img src={PHOTO.tech} alt="" loading="lazy" /></span>
                  <span class="mega-tag">White label</span>
                  <b>{L("Your brand. Our technology.", "Sua marca. Nossa tecnologia.")}</b>
                  <small>{L("Systems and apps for any kind of business, delivered under your own name.", "Sistemas e apps para qualquer tipo de negócio, entregues com o seu nome.")}</small>
                  <span class="mega-more">{L("See the platform →", "Conheça a plataforma →")}</span>
                </a>
              </div></div>
          : keys.length > 1
          ? <div class="has-sub"><a href={u} class:list={["nl", { on: keys.includes(page) }]}>{t}<svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" /></svg></a>
              <div class="sub">{countries.map(([c, cu]) => <a href={cu}>{c}</a>)}</div></div>
          : <a href={u} class:list={["nl", { on: keys.includes(page) }]}>{t}</a>)}
      </nav>
      <div class="top-r">
        <div class="lang" role="group" aria-label={L("Language", "Idioma")}>
          <a href={here.EN} hreflang="en" class:list={{ on: !pt }} aria-current={!pt ? "true" : undefined} title="English (US)"><Flag c="US" /><span>EN</span></a>
          <a href={here.PT} hreflang="pt-BR" class:list={{ on: pt }} aria-current={pt ? "true" : undefined} title="Português (Brasil)"><Flag c="BR" /><span>PT</span></a>
        </div>
        <a class="btn sm hide-m" href={`${R.home}#contact`}>{L("Connect with Us", "Fale Conosco")}</a>
        <button class="burger" aria-label={L("Menu", "Menu")} aria-expanded="false" aria-controls="mnav"><span></span><span></span></button>
      </div>
    </div>
    <div id="mnav" class="mnav" hidden>
      {nav.map(([t, u, keys]) => keys.length > 1 ? countries.map(([c, cu]) => <a href={cu}>{c}</a>) : <a href={u}>{t}</a>)}
      <a class="btn" href={`${R.home}#contact`}>{L("Connect with Us", "Fale Conosco")}</a>
    </div>
  </header>

  <main id="main" transition:animate="fade"><slot /></main>

  <footer class="foot">
    <div class="wrap">
      <div class="foot-cta reveal">
        <h2>{L("Your next market, built on structure and clarity.", "Seu próximo mercado, construído com estrutura e clareza.")}</h2>
        <a class="btn light" href={`${R.home}#contact`}>{L("Connect with Us", "Fale Conosco")}<span class="arr">→</span></a>
      </div>
      <div class="foot-grid">
        <div class="foot-co">
          <img class="foot-logo" src={IMG.logo} alt="Connectas" width="150" height="40" loading="lazy" />
          <p>{COMPANY.legal}<br />{COMPANY.address1}<br />{COMPANY.address2}</p>
          <p><a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a></p>
        </div>
        <nav aria-label={L("Company", "Empresa")}>
          <b>{L("Company", "Empresa")}</b>
          <a href={R.solutions}>{L("Solutions", "Soluções")}</a>
          <a href={R.technology}>{L("Technology", "Tecnologia")}</a>
          {INSIGHTS_ON && <a href={R.insights}>{L("Market Insights", "Insights")}</a>}
          <a href={R.about}>{L("Meet the Founder", "Conheça o Fundador")}</a>
        </nav>
        <nav aria-label={L("Countries", "Países")}>
          <b>{L("Countries", "Países")}</b>
          {countries.map(([c, cu]) => <a href={cu}>{c}</a>)}
        </nav>
        <nav aria-label={L("Legal", "Legal")}>
          <b>{L("Legal", "Legal")}</b>
          <a href={R.terms}>{L("Terms of Service", "Termos de Serviço")}</a>
          <a href={R.privacy}>{L("Privacy Policy", "Política de Privacidade")}</a>
          <a href={R.cookies}>{L("Cookie Policy", "Política de Cookies")}</a>
          <a href={R.refunds}>{L("Cancellation & Refunds", "Cancelamento e Reembolso")}</a>
          <a href={R.dataprotection}>{L("Data Protection", "Proteção de Dados")}</a>
          <a href={R.ethics}>{L("Compliance & Ethics", "Ética e Compliance")}</a>
          <a href={R.accessibility}>{L("Accessibility", "Acessibilidade")}</a>
        </nav>
      </div>
      <div class="foot-base">
        <span>© {year} {COMPANY.legal}. {L("All rights reserved.", "Todos os direitos reservados.")}</span>
        <button type="button" class="cookie-btn" data-cookie-settings>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9 3 3 0 0 1-3-3 3 3 0 0 1-3-3 3 3 0 0 1-3-3Z" /><circle cx="8.5" cy="11" r="1" /><circle cx="12" cy="16" r="1" /><circle cx="15.5" cy="13" r="1" /></svg>
          {L("Cookie preferences", "Preferências de cookies")}
        </button>
      </div>
    </div>
  </footer>

  <CookieNotice lang={lang} />

  <script is:inline>
    (function () {
      function init() {
        // Reveal on scroll, staggered inside groups
        var els = document.querySelectorAll(".reveal:not(.in)");
        if (!("IntersectionObserver" in window)) { els.forEach(function (e) { e.classList.add("in"); }); }
        else {
          var io = new IntersectionObserver(function (es) {
            es.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add("in"); io.unobserve(en.target); } });
          }, { rootMargin: "0px 0px -8% 0px", threshold: 0.08 });
          els.forEach(function (e) { io.observe(e); });
        }
        document.querySelectorAll("[data-stagger]").forEach(function (g) {
          Array.prototype.forEach.call(g.children, function (c, i) { c.style.setProperty("--d", (i * 90) + "ms"); });
        });
        // Animated counters
        document.querySelectorAll("[data-count]:not([data-done])").forEach(function (el) {
          var o = new IntersectionObserver(function (es) {
            if (!es[0].isIntersecting) return; o.disconnect(); el.setAttribute("data-done", "");
            var to = parseFloat(el.getAttribute("data-count")), t0 = performance.now(), dur = 1600;
            (function step(t) { var p = Math.min(1, (t - t0) / dur), e = 1 - Math.pow(1 - p, 3); el.textContent = Math.round(to * e); if (p < 1) requestAnimationFrame(step); })(t0);
          }, { threshold: 0.4 });
          o.observe(el);
        });
        // Mobile menu
        var b = document.querySelector(".burger"), m = document.getElementById("mnav");
        if (b && m && !b.dataset.bound) {
          b.dataset.bound = "1";
          b.addEventListener("click", function () { var open = m.hidden; m.hidden = !open; b.setAttribute("aria-expanded", String(open)); document.body.classList.toggle("menu-open", open); });
        }
        if (m) { m.hidden = true; document.body.classList.remove("menu-open"); if (b) b.setAttribute("aria-expanded", "false"); }
      }
      // Close the mega menu / dropdown as soon as an item is chosen; it opens again once the pointer has left it
      if (!window.__cnxMenuClose) {
        window.__cnxMenuClose = true;
        var lastUsed = null;
        var arm = function (box) {
          box.classList.add("shut"); if (document.activeElement) document.activeElement.blur();
          var off = function (ev) { if (!box.contains(ev.target)) { box.classList.remove("shut"); document.removeEventListener("pointermove", off); } };
          document.addEventListener("pointermove", off);
        };
        document.addEventListener("click", function (e) {
          var a = e.target.closest && e.target.closest(".mega a, .sub a"); if (!a) return;
          var box = a.closest(".has-mega, .has-sub"); if (!box) return;
          lastUsed = box.classList.contains("has-mega") ? ".has-mega" : ".has-sub"; arm(box);
        });
        document.addEventListener("astro:after-swap", function () { if (lastUsed) { var b = document.querySelector(lastUsed); if (b) arm(b); lastUsed = null; } });
      }
      function onScroll() { document.documentElement.classList.toggle("scrolled", window.scrollY > 24); }
      window.addEventListener("scroll", onScroll, { passive: true }); onScroll();
      document.addEventListener("astro:page-load", init);
    })();
  </script>
</body>
</html>
