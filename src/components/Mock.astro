---
// Illustrative screens drawn in HTML/CSS (no real client data). Every mock carries an "Example" label.
import type { Lang } from "../lib/routes";
import Device from "./Device.astro";
const { kind, lang = "EN" } = Astro.props as { kind: string; lang?: Lang };
const pt = lang === "PT";
const L = (en: string, p: string) => (pt ? p : en);
const ex = L("Example", "Exemplo");
---
{kind === "dashboard" && (
  <div class="dev-pair"><Device kind="imac" src="/shots/imac-system.jpg" alt={L("Operations dashboard of a management system", "Painel de operações de um sistema de gestão")} /><Device kind="iphone" src="/shots/iphone-app.jpg" alt={L("Client app home screen", "Tela inicial do app do cliente")} /></div>
)}
{kind === "signin" && (
  <div class="dev-pair"><Device kind="imac" src="/shots/imac-login.jpg" alt={L("Branded sign-in page of a client portal", "Página de login com a marca do cliente")} /><Device kind="iphone" src="/shots/iphone-login.jpg" alt={L("Sign-in screen of the mobile app", "Tela de login do app")} /></div>
)}
{kind === "roles" && (
  <Device kind="imac"><div class="mk-desk"><div class="mk-desk-bar"><b>Atlas Clinics</b><span></span><span></span><span></span><i></i></div><div class="mk-desk-body"><div class="mk mk-card"><div class="mk-h">{L("Roles and permissions", "Perfis e permissões")}<em>{ex}</em></div>
    <table class="mk-table"><thead><tr><th></th><th>{L("Admin", "Admin")}</th><th>{L("Staff", "Equipe")}</th><th>{L("Client", "Cliente")}</th></tr></thead>
      <tbody>{[[L("See every client", "Ver todos os clientes"), 1, 0, 0], [L("Assigned clients", "Clientes atribuídos"), 1, 1, 0], [L("Own documents", "Próprios documentos"), 1, 1, 1], [L("Approve quotes", "Aprovar orçamentos"), 1, 1, 1], [L("Billing", "Cobrança"), 1, 0, 0]].map(([t, a, b, c]) => <tr><td>{t}</td>{[a, b, c].map((v) => <td>{v ? <span class="y">✓</span> : <span class="n">—</span>}</td>)}</tr>)}</tbody></table>
    <small>{L("Each company's data is isolated by the database itself.", "Os dados de cada empresa ficam isolados pelo próprio banco de dados.")}</small></div></div></div></Device>
)}
{kind === "payments" && (
  <Device kind="imac"><div class="mk-desk"><div class="mk-desk-bar"><b>Atlas Clinics</b><span></span><span></span><span></span><i></i></div><div class="mk-desk-body"><div class="mk mk-card mk-pay"><div class="mk-h">{L("Your plan", "Seu plano")}<em>{ex}</em></div>
    <div class="mk-plan"><div><b>{L("Base subscription", "Assinatura base")}</b><small>{L("Monthly · cancel with 30 days' notice", "Mensal · cancelamento com 30 dias de aviso")}</small></div><span class="mk-pill">{L("Active", "Ativo")}</span></div>
    <div class="mk-plan"><div><b>{L("Property management", "Gestão de imóveis")}</b><small>{L("Add-on module", "Módulo adicional")}</small></div><span class="mk-btn sm">{L("Add", "Adicionar")}</span></div>
    <div class="mk-cardline"><span>•••• •••• •••• 4242</span><span>VISA</span></div>
    <small>{L("Card payments by Stripe — card details never touch our servers.", "Pagamentos com cartão pelo Stripe — os dados do cartão nunca passam pelos nossos servidores.")}</small></div></div></div></Device>
)}
{kind === "domain" && (
  <div class="dev-pair"><Device kind="imac"><div class="mk mk-browser mk-live"><div class="mk-bar"><i style="background:#FF5F57"></i><i style="background:#FEBC2E"></i><i style="background:#28C840"></i><span><b class="lock" aria-hidden="true"></b>portal.cmrmobility.gy</span></div><img src="/shots/imac-hr.jpg" alt={L("Client portal on the company's own domain", "Portal do cliente no domínio da própria empresa")} loading="lazy" /></div></Device>
    <Device kind="iphone"><div class="mk mk-mail">
      <div class="mm-top"><span>‹ {L("Inbox", "Entrada")}</span><span class="mm-ic">⌃ ⌄</span></div>
      <div class="mm-from"><span class="mm-av"><img src="/partners/cmr.png" alt="" /></span><div><b>CMRmobility</b><small>noreply@cmrmobility.gy</small></div><small class="mm-time">9:38</small></div>
      <h5>{L("Your housing shortlist is ready", "Sua pré-seleção de imóveis está pronta")}</h5>
      <div class="mm-card">
        <div class="mm-head"><img src="/partners/cmr.png" alt="CMRmobility" /></div>
        <div class="mm-body"><p><b>{L("Hi Michael,", "Olá, Michael,")}</b></p><p>{L("We selected 3 homes that match your company's policy. Review them and book your viewings.", "Selecionamos 3 imóveis dentro da política da sua empresa. Veja as opções e agende as visitas.")}</p>
          <span class="mm-btn">{L("Open my portal", "Abrir meu portal")}</span>
          <small>CMRmobility · Georgetown, Guyana</small></div>
      </div>
    </div></Device></div>
)}
{kind === "phone" && (
  <Device kind="iphone" src="/shots/iphone-app.jpg" alt={L("Client app home screen", "Tela inicial do app do cliente")} />
)}
{kind === "website" && (
  <Device kind="imac"><div class="mk mk-browser mk-live"><div class="mk-bar"><i style="background:#FF5F57"></i><i style="background:#FEBC2E"></i><i style="background:#28C840"></i><span><b class="lock" aria-hidden="true"></b>swervecreativeagency.com</span></div><img src="/shots/site-swerve.jpg" alt={L("Website of a creative agency built on our platform", "Site de uma agência criativa feito na nossa plataforma")} loading="lazy" /></div></Device>
)}
{kind === "portal" && (
  <Device kind="imac" src="/shots/imac-hr.jpg" alt={L("Client portal for a corporate HR team", "Portal do cliente para o RH de uma empresa")} />
)}
{kind === "whitelabel" && (
  <div class="mk mk-duo mk-trio"><Device kind="iphone" src="/shots/iphone-app.jpg" alt={L("A relocation company's app", "App de uma empresa de realocação")} /><Device kind="iphone" cls="ip-dark" src="/shots/app-nettoverse.jpg" pos="top" alt={L("A publishing brand's app", "App de uma marca editorial")} /><Device kind="iphone" cls="ip-dark" src="/shots/app-swerve.jpg" pos="top" alt={L("A creative agency's app", "App de uma agência criativa")} /></div>
)}
