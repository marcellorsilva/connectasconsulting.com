---
// Animated network of points and lines — the Connectas "bridge" motif. Moves slowly, reacts to the pointer,
// pauses when off screen and stays still for people who prefer reduced motion.
const { dark = false, density = 1 } = Astro.props as { dark?: boolean; density?: number };
---
<canvas data-net data-dark={dark ? "1" : "0"} data-density={density} aria-hidden="true"></canvas>
<script is:inline>
  (function () {
    if (window.__cnxNet) return; window.__cnxNet = true;
    function start(cv) {
      if (cv.__on) return; cv.__on = true;
      var ctx = cv.getContext("2d"), dpr = Math.min(2, window.devicePixelRatio || 1), W = 0, H = 0, pts = [], mouse = { x: -9999, y: -9999 };
      var dark = cv.dataset.dark === "1", dens = parseFloat(cv.dataset.density || "1");
      var still = window.matchMedia("(prefers-reduced-motion: reduce)").matches, visible = true, raf = 0;
      function size() {
        var r = cv.getBoundingClientRect(); W = r.width; H = r.height; cv.width = W * dpr; cv.height = H * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        var n = Math.round(Math.min(110, (W * H) / 15000) * dens); pts = [];
        for (var i = 0; i < n; i++) pts.push({ x: Math.random() * W, y: Math.random() * H, vx: (Math.random() - .5) * .22, vy: (Math.random() - .5) * .22, r: Math.random() * 1.6 + .8 });
      }
      function frame() {
        ctx.clearRect(0, 0, W, H);
        var c = dark ? "255,255,255" : "0,0,0", max = Math.min(170, W / 7);
        for (var i = 0; i < pts.length; i++) {
          var p = pts[i];
          if (!still) { p.x += p.vx; p.y += p.vy; if (p.x < 0 || p.x > W) p.vx *= -1; if (p.y < 0 || p.y > H) p.vy *= -1; }
          var dxm = p.x - mouse.x, dym = p.y - mouse.y, dm = Math.sqrt(dxm * dxm + dym * dym);
          if (dm < 140 && !still) { p.x += dxm / dm * .6; p.y += dym / dm * .6; }
          for (var j = i + 1; j < pts.length; j++) {
            var q = pts[j], dx = p.x - q.x, dy = p.y - q.y, d = Math.sqrt(dx * dx + dy * dy);
            if (d < max) { ctx.strokeStyle = "rgba(" + c + "," + (dark ? .22 : .13) * (1 - d / max) + ")"; ctx.lineWidth = .8; ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(q.x, q.y); ctx.stroke(); }
          }
          ctx.fillStyle = "rgba(" + c + "," + (dark ? .55 : .35) + ")"; ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, 6.283); ctx.fill();
        }
        if (!still && visible && document.body.contains(cv)) raf = requestAnimationFrame(frame);
      }
      size(); frame();
      window.addEventListener("resize", function () { size(); if (still) frame(); });
      cv.parentElement.addEventListener("pointermove", function (e) { var r = cv.getBoundingClientRect(); mouse.x = e.clientX - r.left; mouse.y = e.clientY - r.top; });
      cv.parentElement.addEventListener("pointerleave", function () { mouse.x = mouse.y = -9999; });
      if ("IntersectionObserver" in window) new IntersectionObserver(function (es) { var v = es[0].isIntersecting; if (v && !visible && !still) { visible = true; raf = requestAnimationFrame(frame); } else if (!v) { visible = false; cancelAnimationFrame(raf); } }).observe(cv);
    }
    document.addEventListener("astro:page-load", function () { document.querySelectorAll("canvas[data-net]").forEach(start); });
  })();
</script>
