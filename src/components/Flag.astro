---
// Small flags: US = English, BR = Português (Brasil); GY = Guyana (used on the audience cards).
const { c } = Astro.props as { c: "US" | "BR" | "GY" };
---
{c === "GY" ? <svg class="flag" viewBox="0 0 30 20" aria-hidden="true"><rect width="30" height="20" fill="#009E49" /><polygon points="0,0 30,10 0,20" fill="#FFFFFF" /><polygon points="0,1.3 27.4,10 0,18.7" fill="#FCD116" /><polygon points="0,0 15,10 0,20" fill="#000000" /><polygon points="0,1.5 13.2,10 0,18.5" fill="#CE1126" /></svg> : c === "US"
  ? <svg class="flag" viewBox="0 0 30 20" aria-hidden="true"><rect width="30" height="20" fill="#B22234" /><g fill="#FFFFFF">{[1, 3, 5, 7, 9, 11].map((i) => <rect y={i * 20 / 13} width="30" height={20 / 13} />)}</g><rect width="12" height={20 * 7 / 13} fill="#3C3B6E" /><g fill="#FFFFFF">{[0, 1, 2, 3].map((r) => [0, 1, 2, 3, 4].map((k) => <circle cx={1.4 + k * 2.3 + (r % 2) * 1.15} cy={1.4 + r * 2.4} r="0.55" />))}</g></svg>
  : <svg class="flag" viewBox="0 0 30 20" aria-hidden="true"><rect width="30" height="20" fill="#009C3B" /><polygon points="15,2.2 27.6,10 15,17.8 2.4,10" fill="#FFDF00" /><circle cx="15" cy="10" r="4.6" fill="#002776" /><path d="M10.6 9.1 Q15 7.7 19.5 10.9" stroke="#FFFFFF" stroke-width="0.9" fill="none" /></svg>}
