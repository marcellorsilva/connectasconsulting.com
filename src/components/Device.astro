---
// Realistic device frames drawn in CSS: an iMac (white bezel, coloured chin, stand) and an iPhone
// (iPhone 17: aluminium band, Dynamic Island, Action button, volume, side button, Camera Control). Pass an image src, or put HTML inside the slot.
const { kind, src, alt = "" } = Astro.props as { kind: "imac" | "iphone"; src?: string; alt?: string };
---
{kind === "imac"
  ? <figure class="dev-imac"><div class="imac-body"><div class="imac-screen">{src ? <img src={src} alt={alt} loading="lazy" /> : <slot />}</div><div class="imac-chin"></div></div><div class="imac-neck"></div><div class="imac-foot"></div></figure>
  : <figure class="dev-iphone"><span class="ip-btn ip-a"></span><span class="ip-btn ip-b"></span><span class="ip-btn ip-c"></span><span class="ip-btn ip-d"></span><span class="ip-btn ip-e"></span><div class="ip-frame"><div class="ip-screen">{src ? <><span class="ip-status" aria-hidden="true"><b>9:41</b><i class="ip-sig"></i><i class="ip-wifi"></i><i class="ip-bat"></i></span><img class="ip-shot" src={src} alt={alt} loading="lazy" /></> : <slot />}<span class="ip-island"></span></div></div></figure>}
