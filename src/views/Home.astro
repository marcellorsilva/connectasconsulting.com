---
import Base from "../layouts/Base.astro";
import Network from "../components/Network.astro";
import ContactForm from "../components/ContactForm.astro";
import Flag from "../components/Flag.astro";
import { COMPANY, IMG } from "../company";
import { ROUTES, postUrl, type Lang } from "../lib/routes";
import { ICON } from "../lib/icons";
import { SERVICES } from "../lib/services";
import { POSTS } from "../blog/posts";
const { lang } = Astro.props as { lang: Lang };
const pt = lang === "PT";
const L = (en: string, p: string) => (pt ? p : en);
const R = ROUTES[lang];
const words = pt ? ["os Estados Unidos", "o Brasil", "a Guiana"] : ["the United States", "Brazil", "Guyana"];
const audiences = [
  { from: "BR", to: "GY", t: L("Brazilian companies expanding to Guyana", "Empresas brasileiras expandindo para a Guiana"), d: L("Be part of one of the fastest-growing economies in the world.", "Faça parte de uma das economias que mais crescem no mundo."), u: R.guyana },
  { from: "US", to: "US", t: L("U.S. companies expanding nationwide and abroad", "Empresas americanas expandindo nos EUA e no exterior"), d: L("Structure, people and technology in one plan.", "Estrutura, pessoas e tecnologia em um só plano."), u: R.usa },
  { from: "GY", to: "BR", t: L("Guyanese companies doing business with Brazil", "Empresas guianenses fazendo negócios com o Brasil"), d: L("Access to Latin America's largest market.", "Acesso ao maior mercado da América Latina."), u: R.brazil },
  { from: "US", to: "BR", t: L("U.S. investors entering Brazil and Guyana", "Investidores americanos entrando no Brasil e na Guiana"), d: L("Local knowledge, from the first meeting to the first contract.", "Conhecimento local, da primeira reunião ao primeiro contrato."), u: R.solutions },
];
const steps = [
  [L("Discover", "Descobrir"), L("We understand your goals, timeline and budget.", "Entendemos seus objetivos, prazos e orçamento.")],
  [L("Plan", "Planejar"), L("Your business plan and one roadmap covering company, people and technology.", "Seu plano de negócios e um só roteiro para empresa, pessoas e tecnologia.")],
  [L("Launch", "Lançar"), L("We register, relocate, build and market — all coordinated by one team.", "Registramos, realocamos, construímos e divulgamos — tudo coordenado por uma só equipe.")],
  [L("Grow", "Crescer"), L("We stay by your side while you operate and expand.", "Seguimos ao seu lado enquanto você opera e cresce.")],
];
const stats = [
  [300, "+", L("Families relocated", "Famílias realocadas")], [98, "%", L("Client satisfaction rate", "Taxa de satisfação dos clientes")],
  [60, "%", L("Faster market entry", "Entrada mais rápida no mercado")], [50, "M+", L("In business generated", "Em negócios gerados")],
];
const why = [
  [L("On the ground in all three countries.", "Presença nos três países."), L("We don't outsource your expansion — we run it, with people who know how things work locally.", "Não terceirizamos a sua expansão — nós a conduzimos, com quem conhece como as coisas funcionam em cada lugar.")],
  [L("One point of contact.", "Um só ponto de contato."), L("No more coordinating lawyers, agents, movers and developers yourself. One team, one plan.", "Chega de coordenar sozinho advogados, corretores, mudanças e desenvolvedores. Uma equipe, um plano.")],
  [L("Technology and marketing included.", "Tecnologia e marketing inclusos."), L("Your website, systems, apps and brand launch are part of the plan — not an afterthought.", "Seu site, sistemas, apps e o lançamento da marca fazem parte do plano — não ficam para depois.")],
];
const latest = [...POSTS].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 3);
const fmt = (d: string) => new Date(d + "T12:00:00").toLocaleDateString(pt ? "pt-BR" : "en-US", { day: "numeric", month: "short", year: "numeric" });
---
<Base lang={lang} page="home"
  title={L("Connectas · Your strategic bridge between the United States, Brazil and Guyana", "Connectas · Sua ponte estratégica entre Estados Unidos, Brasil e Guiana")}
  description={L("Business plans, company registration, market entry, relocation, websites, systems, white-label apps and marketing — one partner for doing business between the United States, Brazil and Guyana.", "Plano de negócios, abertura de empresa, entrada no mercado, realocação, sites, sistemas, apps white label e marketing — um só parceiro para fazer negócios entre Estados Unidos, Brasil e Guiana.")}>

  <section class="hero">
    <Network />
    <div class="wrap">
      <span class="eyebrow fade-up" style="--d:100ms">{L("Business across borders", "Negócios além das fronteiras")}</span>
      <h1>
        <span class="mask-line"><span style="--d:150ms">{L("Your strategic bridge between", "Sua ponte estratégica entre")}</span></span>
        <span class="mask-line"><span style="--d:300ms"><span class="rot" data-rot>{words.map((w, i) => <span class:list={{ on: i === 0 }}>{w}</span>)}</span></span></span>
      </h1>
      <div class="countries fade-up" style="--d:650ms"><span>{L("United States", "Estados Unidos")}</span><i></i><span>{L("Brazil", "Brasil")}</span><i></i><span>{L("Guyana", "Guiana")}</span></div>
      <p class="lead fade-up" style="--d:800ms">{L("One partner to plan your business, open your company, move your people, build your technology and launch your brand — in three countries where we are already on the ground.", "Um só parceiro para planejar o seu negócio, abrir a sua empresa, mudar a sua equipe, construir a sua tecnologia e lançar a sua marca — em três países onde já estamos presentes.")}</p>
      <div class="row fade-up" style="--d:950ms"><a class="btn" href="#contact">{L("Start your expansion", "Comece sua expansão")}<span class="arr">→</span></a><a class="btn ghost" href={R.solutions}>{L("All solutions", "Todas as soluções")}</a></div>
    </div>
    <span class="scroll-cue" aria-hidden="true"></span>
  </section>

  <div class="trusted">
    <div class="wrap">
      <span class="lbl">{L("Trusted by industry leaders", "A confiança de quem lidera")}</span>
      <div class="marquee" aria-label={L("Clients and partners", "Clientes e parceiros")}><div class="marquee-track">{[...IMG.partners, ...IMG.partners].map((src, i) => <img src={src} alt="" loading="lazy" aria-hidden={i >= IMG.partners.length ? "true" : undefined} />)}</div></div>
    </div>
  </div>

  <section>
    <div class="wrap split">
      <div class="reveal">
        <span class="eyebrow">{L("What we do", "O que fazemos")}</span>
        <h2>{L("Expanding to a new country shouldn't mean hiring five different companies.", "Expandir para outro país não deveria exigir contratar cinco empresas diferentes.")}</h2>
      </div>
      <div class="reveal" style="--d:150ms">
        <p class="big-quote">{L("With Connectas, you deal with one team, one plan and one point of contact.", "Com a Connectas, você lida com uma equipe, um plano e um ponto de contato.")}</p>
        <p class="lead">{L("We write your business plan, register your company, find the right local partners, relocate your executives and their families, build your websites, systems and apps — and launch your brand in the new market.", "Escrevemos o seu plano de negócios, registramos a sua empresa, encontramos os parceiros locais certos, realocamos seus executivos e suas famílias, construímos seus sites, sistemas e apps — e lançamos a sua marca no novo mercado.")}</p>
        <p class="muted">{L("We already operate in the United States, Brazil and Guyana. That means real local knowledge, not a list of referrals.", "Já atuamos nos Estados Unidos, no Brasil e na Guiana. Isso significa conhecimento local de verdade, não uma lista de indicações.")}</p>
      </div>
    </div>
  </section>

  <section class="grey">
    <div class="wrap">
      <div class="split" style="margin-bottom:56px;align-items:end">
        <div class="reveal"><span class="eyebrow">{L("Our services", "Nossos serviços")}</span><h2>{L("Everything your expansion needs.", "Tudo o que a sua expansão precisa.")}</h2></div>
        <p class="lead reveal" style="--d:120ms">{L("From the first spreadsheet to the first client: seven services, one coordinated process.", "Da primeira planilha ao primeiro cliente: sete serviços, um só processo coordenado.")}</p>
      </div>
      <div class="svc-grid" data-stagger class:list={["reveal"]}>
        {SERVICES.map((s, i) => <a class="svc" href={`${R.solutions}#${s.key}`} style="text-decoration:none">
          <span class="n">0{i + 1}</span><span class="ic" set:html={ICON[s.icon]} /><h3>{s.title[lang]}</h3><p>{s.short[lang]}</p></a>)}
        <a class="svc" href={R.solutions} style="text-decoration:none;justify-content:center;align-items:flex-start">
          <span class="n">→</span><h3 style="font-size:clamp(26px,2.6vw,36px);letter-spacing:-0.03em">{L("See how each service works", "Veja como cada serviço funciona")}</h3><p>{L("All solutions", "Todas as soluções")} →</p></a>
      </div>
    </div>
  </section>

  <section class="black">
    <div class="wrap">
      <div class="reveal" style="max-width:820px;margin-bottom:56px"><span class="eyebrow">{L("We are for…", "Para quem é")}</span><h2>{L("Companies and investors moving between three markets.", "Empresas e investidores circulando entre três mercados.")}</h2></div>
      <div class="aud" data-stagger class:list={["reveal"]}>
        {audiences.map((a) => <a href={a.u}><span class="route"><Flag c={a.from as "US" | "BR" | "GY"} /><span class="ln"></span><Flag c={a.to as "US" | "BR" | "GY"} /></span><h3>{a.t}</h3><p>{a.d}</p></a>)}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="reveal" style="margin-bottom:56px"><span class="eyebrow">{L("How it works", "Como funciona")}</span><h2>{L("Four steps. One team.", "Quatro etapas. Uma equipe.")}</h2></div>
      <div class="steps reveal" data-stagger>{steps.map(([t, d], i) => <div class="step"><span class="k">0{i + 1}</span><h3>{t}</h3><p>{d}</p></div>)}</div>
    </div>
  </section>

  <section class="black" style="overflow:hidden">
    <Network dark density={0.6} />
    <div class="wrap" style="position:relative">
      <div class="reveal" style="margin-bottom:60px"><span class="eyebrow">{L("Our impact", "Nosso impacto")}</span><h2>{L("Results that cross borders.", "Resultados que cruzam fronteiras.")}</h2></div>
      <div class="stats reveal" data-stagger>{stats.map(([v, suf, l]) => <div class="stat"><div class="v"><span data-count={v}>{v}</span><small>{suf}</small></div><div class="l">{l}</div></div>)}</div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="reveal" style="margin-bottom:56px;max-width:820px"><span class="eyebrow">{L("Why Connectas", "Por que a Connectas")}</span><h2>{L("Confidence comes from being there.", "Confiança vem de estar presente.")}</h2></div>
      <div class="why reveal" data-stagger>{why.map(([t, d]) => <div><h3>{t}</h3><p>{d}</p></div>)}</div>
    </div>
  </section>

  <section class="grey">
    <div class="wrap">
      <div class="split" style="margin-bottom:50px;align-items:end">
        <div class="reveal"><span class="eyebrow">{L("Market insights", "Insights de mercado")}</span><h2>{L("What's moving in Guyana.", "O que está mudando na Guiana.")}</h2></div>
        <div class="reveal" style="--d:120ms;text-align:right"><a class="btn ghost" href={R.insights}>{L("All articles", "Todos os artigos")}<span class="arr">→</span></a></div>
      </div>
      <div class="posts reveal" data-stagger>
        {latest.map((p) => <a class="post-card" href={postUrl(lang, p.slug)}><div class="img-frame"><img src={p.img} alt={p.alt[lang]} loading="lazy" /></div><span class="meta"><span>{fmt(p.date)}</span><span>·</span><span>{p.tag[lang]}</span></span><h3>{p.title[lang]}</h3></a>)}
      </div>
    </div>
  </section>

  <section id="contact">
    <div class="wrap contact-grid">
      <div class="reveal">
        <span class="eyebrow">{L("Contact", "Contato")}</span>
        <h2>{L("Ready to cross borders with confidence?", "Pronto para cruzar fronteiras com confiança?")}</h2>
        <p class="lead">{L("Tell us where you are and where you want to go. We reply within two business days with the next steps.", "Conte onde você está e aonde quer chegar. Respondemos em até dois dias úteis com os próximos passos.")}</p>
        <div class="contact-info">
          <div class="ci"><span>{L("E-mail", "E-mail")}</span><a class="link" href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a></div>
          <div class="ci"><span>{L("Head office", "Sede")}</span><p>{COMPANY.legal}<br />{COMPANY.address1}<br />{COMPANY.address2}</p></div>
          <div class="ci"><span>{L("Where we work", "Onde atuamos")}</span><p>{L("United States · Brazil · Guyana", "Estados Unidos · Brasil · Guiana")}</p></div>
        </div>
      </div>
      <div class="reveal" style="--d:150ms"><ContactForm lang={lang} /></div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var t;
      document.addEventListener("astro:page-load", function () {
        clearInterval(t); var r = document.querySelector("[data-rot]"); if (!r) return;
        var it = r.children, i = 0;
        t = setInterval(function () {
          if (!document.body.contains(r)) return clearInterval(t);
          var a = it[i]; i = (i + 1) % it.length; var b = it[i];
          a.classList.remove("on"); a.classList.add("out"); b.classList.remove("out"); b.classList.add("on");
          setTimeout(function () { a.classList.remove("out"); }, 900);
        }, 2600);
      });
    })();
  </script>
</Base>
