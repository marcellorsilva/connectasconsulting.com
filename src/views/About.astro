---
import Base from "../layouts/Base.astro";
import Network from "../components/Network.astro";
import { ROUTES, type Lang } from "../lib/routes";
import { PHOTO } from "../company";
const { lang } = Astro.props as { lang: Lang };
const pt = lang === "PT";
const L = (en: string, p: string) => (pt ? p : en);
const R = ROUTES[lang];
---
<Base lang={lang} page="about" title={L("Connectas · Meet the Founder", "Connectas · Conheça o Fundador")}
  description={L("Marcello Silva: 20+ years helping companies and people succeed in new countries, with a background in IT, an MBA in Commercial Management and global mobility leadership.", "Marcello Silva: mais de 20 anos ajudando empresas e pessoas a terem sucesso em novos países, com formação em TI, MBA em Gestão Comercial e liderança em mobilidade global.")}>
  <section class="phero">
    <Network density={0.6} />
    <div class="wrap">
      <span class="eyebrow fade-up">{L("Meet the founder", "Conheça o fundador")}</span>
      <h1><span class="mask-line"><span style="--d:100ms">{L("Meet Marcello Silva.", "Conheça Marcello Silva.")}</span></span></h1>
    </div>
  </section>

  <section>
    <div class="wrap founder">
      <figure class="founder-photo reveal"><img src={PHOTO.founder} alt="Marcello Silva" /></figure>
      <div class="reveal" style="--d:120ms">
        <p class="big-quote">{L("Connecting people and opportunities beyond borders.", "Conectando pessoas e oportunidades além das fronteiras.")}</p>
        <p class="lead">{L("Marcello Silva has spent more than 20 years helping companies and people succeed in new countries — and he has done it himself, living and working in England, Brazil, Guyana and the United States.", "Marcello Silva passou mais de 20 anos ajudando empresas e pessoas a terem sucesso em novos países — e viveu isso na prática, morando e trabalhando na Inglaterra, no Brasil, na Guiana e nos Estados Unidos.")}</p>
        <p>{L("His career has been built one country at a time — and each one added a different skill:", "Sua carreira foi construída país a país — e cada um somou uma competência diferente:")}</p>
        <ul class="founder-path">
          <li><b>{L("England", "Inglaterra")}</b><span>{L("Financial markets, working between England and Brazil — where he learned the discipline of numbers, risk and results.", "Mercado financeiro, atuando entre a Inglaterra e o Brasil — onde aprendeu a disciplina dos números, do risco e dos resultados.")}</span></li>
          <li><b>{L("Brazil", "Brasil")}</b><span>{L("Technology at Oracle and Microsoft; people and employment at Latin America's largest non-profit dedicated to human resources and job creation; and the global mobility industry with Sirva and Aires, two of the world's largest companies in the sector.", "Tecnologia na Oracle e na Microsoft; pessoas e empregabilidade na maior ONG da América Latina dedicada a recursos humanos e geração de empregos; e a indústria de mobilidade global com a Sirva e a Aires, duas das maiores empresas do setor no mundo.")}</span></li>
          <li><b>{L("Guyana", "Guiana")}</b><span>{L("Global mobility services for the oil and gas industry, and a retail business — operating every day in one of the fastest-growing economies in the world.", "Serviços de mobilidade global para a indústria de óleo e gás e uma empresa de varejo — operando todos os dias em uma das economias que mais crescem no mundo.")}</span></li>
          <li><b>{L("United States", "Estados Unidos")}</b><span>{L("Connectas, and a creative agency focused on branding and experiences.", "A Connectas e uma agência criativa focada em branding e experiências.")}</span></li>
        </ul>
        <p>{L("Along the way he trained in IT and earned an MBA in Commercial Management with a focus on sales — the mix of technology, business and people that shapes how Connectas works.", "No caminho, formou-se em TI e fez MBA em Gestão Comercial com foco em vendas — a combinação de tecnologia, negócios e pessoas que define o jeito de trabalhar da Connectas.")}</p>
        <p>{L("Connectas brings all of that together: the strategy, the systems and the human side of expansion, in one team. Because moving a business — or a family — to another country should feel organised, confident and well looked after.", "A Connectas reúne tudo isso: a estratégia, os sistemas e o lado humano da expansão, em uma só equipe. Porque levar uma empresa — ou uma família — para outro país deve ser organizado, seguro e bem cuidado.")}</p>
        <ul class="founder-facts">
          <li><b>20+</b><span>{L("years of international experience", "anos de experiência internacional")}</span></li>
          <li><b>4</b><span>{L("countries lived and worked in", "países onde viveu e trabalhou")}</span></li>
          <li><b>IT + MBA</b><span>{L("technology and commercial management", "tecnologia e gestão comercial")}</span></li>
        </ul>
        <a class="btn" href={`${R.home}#contact`} style="margin-top:14px">{L("Talk to Marcello's team", "Fale com a equipe do Marcello")}<span class="arr">→</span></a>
      </div>
    </div>
  </section>
</Base>
