---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";
import { ROUTES, postUrl, serviceUrl, INSIGHTS_ON, type Lang } from "../lib/routes";
import { PHOTO, VIDEO } from "../company";
import { SERVICES } from "../lib/services";
import { COUNTRIES } from "../lib/countries";
import { POSTS } from "../blog/posts";
const { lang, country } = Astro.props as { lang: Lang; country: "guyana" | "brazil" | "usa" };
const pt = lang === "PT";
const L = (en: string, p: string) => (pt ? p : en);
const R = ROUTES[lang];
const C = COUNTRIES[country];
const name = C.name[lang];
// Portuguese needs the article: "o Brasil", "a Guiana", "os Estados Unidos"
const withArt = pt ? ({ usa: "os Estados Unidos", brazil: "o Brasil", guyana: "a Guiana" } as const)[country] : name;
const photo = country === "guyana" ? PHOTO.guyana : country === "brazil" ? PHOTO.brazil : PHOTO.usa;
const video = VIDEO[country];
// What each photo must show: the whole bridge (Brazil), the market roofs (Guyana)
const focus = { brazil: "50% 8%", guyana: "50% 88%", usa: "50% 45%" }[country];
const posts = INSIGHTS_ON && country === "guyana" ? [...POSTS].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 3) : [];
const others = (["guyana", "brazil", "usa"] as const).filter((c) => c !== country);
---
<Base lang={lang} page={country} title={`Connectas · ${C.h1[lang].replace(/\.$/, "")}`} description={C.lead[lang]}>
  <section class="chero">
    <div class="chero-media" aria-hidden="true">
      {video ? <video autoplay muted loop playsinline poster={photo}><source src={video} type="video/mp4" /></video> : <img src={photo} alt="" style={`object-position:${focus}`} />}
    </div>
    <div class="wrap chero-in">
      <span class="eyebrow fade-up">{L("Countries", "Países")} · {name}</span>
      <h1><span class="mask-line"><span style="--d:100ms">{C.h1[lang]}</span></span></h1>
      <p class="lead fade-up" style="--d:400ms">{C.lead[lang]}</p>
      <nav class="chero-nav fade-up" style="--d:550ms" aria-label={L("On this page", "Nesta página")}>
        <a href="#overview">{L("Overview", "Visão geral")}</a><a href="#setup">{L("Opening a company", "Abrir a empresa")}</a><a href="#rules">{L("Taxes & rules", "Impostos e regras")}</a><a href="#living">{L("Living there", "Morar lá")}</a><a href="#faq">{L("Questions", "Perguntas")}</a>
      </nav>
    </div>
  </section>

  <section style="padding-bottom:0">
    <div class="wrap">
      <div class="facts four reveal" data-stagger>{C.facts.map(([v, l, s]) => <div><div class="v">{v[lang]}</div><div class="l">{l[lang]}</div></div>)}</div>
    </div>
  </section>

  <section id="overview" class="anchor">
    <div class="wrap split at">
      <div class="reveal"><span class="eyebrow">{L("Overview", "Visão geral")}</span><h2>{L(`Why ${name}, now.`, `Por que ${withArt}, agora.`)}</h2></div>
      <div class="reveal" style="--d:120ms">{C.overview.map((p) => <p class="lead" style="font-size:18px">{p[lang]}</p>)}</div>
    </div>
    <div class="wrap" style="margin-top:22px">
      <span class="eyebrow reveal">{L("Sectors in demand", "Setores em alta")}</span>
      <div class="tags reveal">{C.sectors[lang].map((s) => <span>{s}</span>)}</div>
    </div>
  </section>

  <section id="setup" class="grey anchor">
    <div class="wrap">
      <div class="split at" style="margin-bottom:30px">
        <div class="reveal"><span class="eyebrow">{L("Opening a company", "Abrir a empresa")}</span><h2>{L("Step by step.", "Passo a passo.")}</h2></div>
        <p class="lead reveal" style="--d:120ms;font-size:18px">{C.setupIntro[lang]}</p>
      </div>
      <ol class="timeline reveal" data-stagger>{C.setup.map(([t, d], i) => <li><span class="n">{String(i + 1).padStart(2, "0")}</span><div><h3>{t[lang]}</h3><p>{d[lang]}</p></div></li>)}</ol>
    </div>
  </section>

  <section id="rules" class="anchor">
    <div class="wrap">
      <div class="reveal" style="max-width:780px;margin-bottom:30px"><span class="eyebrow">{L("Taxes & rules", "Impostos e regras")}</span><h2>{L("What weighs most.", "O que mais pesa.")}</h2></div>
      <div class="rules reveal" data-stagger>{C.rules.map(([t, d]) => <div class="rule"><h3>{t[lang]}</h3><p>{d[lang]}</p></div>)}</div>
      <p class="fine reveal">{L("General information, checked in October 2026. Rules change — we confirm the current position with licensed professionals for every project.", "Informação geral, conferida em outubro de 2026. As regras mudam — confirmamos a situação vigente com profissionais habilitados em cada projeto.")}</p>
    </div>
  </section>

  <section id="living" class="sand anchor">
    <div class="wrap split at">
      <div class="reveal"><span class="eyebrow">{L("Living and relocating", "Morar e realocar")}</span><h2>{L(`Moving people to ${name}.`, `Levar pessoas para ${withArt}.`)}</h2><p class="lead" style="font-size:18px">{C.living[lang]}</p><p class="coverage"><b>{L("Anywhere in the country", "Em qualquer lugar do país")}</b>{C.coverage[lang]}</p></div>
      <ul class="checks reveal" style="--d:120ms">{C.livingList.map((x) => <li style="font-size:17px">{x[lang]}</li>)}</ul>
    </div>
  </section>

  <section>
    <div class="wrap split at">
      <div class="reveal"><span class="eyebrow">{L("How Connectas helps", "Como a Connectas ajuda")}</span><h2>{L("One plan. One team.", "Um plano. Uma equipe.")}</h2><p class="lead" style="font-size:18px">{C.how[lang]}</p></div>
      <div class="rows reveal" style="--d:120ms">{SERVICES.map((s) => <a href={serviceUrl(lang, s.key)} class="srow" style="grid-template-columns:1fr auto;padding:18px 0;text-decoration:none"><h3 style="margin:0;font-size:20px">{s.title[lang]}</h3><span class="muted">→</span></a>)}</div>
    </div>
  </section>

  <section id="faq" class="grey anchor">
    <div class="wrap split at">
      <div class="reveal"><span class="eyebrow">{L("Questions", "Perguntas")}</span><h2>{L(`About ${name}.`, `Sobre ${withArt}.`)}</h2></div>
      <div class="faq reveal" style="--d:120ms">{C.faq.map(([q, a]) => <details><summary>{q[lang]}<i aria-hidden="true"></i></summary><p>{a[lang]}</p></details>)}</div>
    </div>
  </section>

  {posts.length > 0 && <section>
    <div class="wrap">
      <div class="reveal" style="margin-bottom:30px"><span class="eyebrow">{L("Market insights", "Insights de mercado")}</span><h2>{L("Latest from Guyana.", "O mais recente da Guiana.")}</h2></div>
      <div class="posts reveal" data-stagger>{posts.map((p) => <a class="post-card" href={postUrl(lang, p.slug)}><div class="img-frame"><img src={p.img} alt={p.alt[lang]} loading="lazy" /></div><span class="meta">{p.tag[lang]}</span><h3>{p.title[lang]}</h3></a>)}</div>
    </div>
  </section>}

  <section id="contact" class="sand">
    <div class="wrap contact-grid">
      <div class="reveal"><span class="eyebrow">{L("Contact", "Contato")}</span><h2>{L(`Let's talk about ${name}.`, `Vamos falar sobre ${withArt}.`)}</h2><p class="lead">{L("Tell us what you have in mind. We reply within two business days.", "Conte o que você tem em mente. Respondemos em até dois dias úteis.")}</p>
        <div class="other-c">{others.map((o) => <a class="link" href={R[o]}>{COUNTRIES[o].h1[lang].replace(/\.$/, "")} →</a>)}</div>
      </div>
      <div class="reveal" style="--d:150ms"><ContactForm lang={lang} topic="market" /></div>
    </div>
  </section>

</Base>
