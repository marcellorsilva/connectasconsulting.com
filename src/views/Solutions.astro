---
import Base from "../layouts/Base.astro";
import Network from "../components/Network.astro";
import { ROUTES, type Lang } from "../lib/routes";
import { SERVICES } from "../lib/services";
import { ICON } from "../lib/icons";
const { lang } = Astro.props as { lang: Lang };
const pt = lang === "PT";
const L = (en: string, p: string) => (pt ? p : en);
const R = ROUTES[lang];
---
<Base lang={lang} page="solutions" title={L("Connectas · Solutions beyond borders", "Connectas · Soluções além das fronteiras")}
  description={L("Business plans, company registration and structuring, market entry, relocation, websites, systems and apps, marketing and operational support across the United States, Brazil and Guyana.", "Plano de negócios, abertura e estruturação de empresas, entrada no mercado, realocação, sites, sistemas e apps, marketing e suporte operacional entre Estados Unidos, Brasil e Guiana.")}>
  <section class="phero">
    <Network density={0.7} />
    <div class="wrap">
      <span class="eyebrow fade-up">{L("Solutions", "Soluções")}</span>
      <h1><span class="mask-line"><span style="--d:100ms">{L("Beyond borders.", "Além das fronteiras.")}</span></span></h1>
      <p class="lead fade-up" style="--d:400ms">{L("Connectas helps you plan, set up, structure and scale your business across the United States, Brazil and Guyana — and gives you the technology and marketing to run it.", "A Connectas ajuda você a planejar, abrir, estruturar e expandir seu negócio entre Estados Unidos, Brasil e Guiana — e entrega a tecnologia e o marketing para fazê-lo funcionar.")}</p>
      <div class="fade-up" style="--d:550ms;margin-top:30px"><a class="btn" href={`${R.home}#contact`}>{L("Connect with Us", "Fale Conosco")}<span class="arr">→</span></a></div>
    </div>
  </section>

  <section style="padding-top:20px">
    <div class="wrap">
      <div class="rows">
        {SERVICES.map((s, i) => <div class="srow reveal" id={s.key} style="scroll-margin-top:110px">
          <span class="n">0{i + 1}</span>
          <div><span class="ic" style="display:block;width:44px;height:44px;margin-bottom:18px" set:html={ICON[s.icon].replace("<svg", '<svg style="width:100%;height:100%;fill:none;stroke:#000;stroke-width:1"')} /><h3>{s.title[lang]}</h3></div>
          <div><p class="lead" style="font-size:19px;color:var(--text)">{s.long[lang]}</p><p>{s.more[lang]}</p>
            {s.key === "technology" && <p><a class="link" href={R.technology}>{L("See our relocation & property-management platform →", "Conheça nossa plataforma de realocação e gestão de imóveis →")}</a></p>}
            <ul>{s.tags[lang].map((t) => <li>{t}</li>)}</ul></div>
        </div>)}
      </div>
    </div>
  </section>

  <section class="black">
    <div class="wrap split">
      <div class="reveal"><h2>{L("Your next market, built on structure and clarity.", "Seu próximo mercado, construído com estrutura e clareza.")}</h2></div>
      <div class="reveal" style="--d:120ms"><p class="lead" style="color:#BDBDBD">{L("If your company is preparing to enter a new market, expand nationally or structure international operations, Connectas brings the expertise and coordination to move forward with confidence and compliance.", "Se a sua empresa está se preparando para entrar em um novo mercado, expandir nacionalmente ou estruturar operações internacionais, a Connectas traz a experiência e a coordenação para avançar com confiança e em conformidade.")}</p>
        <a class="btn light" href={`${R.home}#contact`}>{L("Discuss your expansion", "Converse sobre a sua expansão")}<span class="arr">→</span></a></div>
    </div>
  </section>
</Base>
