---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";
import Mock from "../components/Mock.astro";
import { ROUTES, type Lang } from "../lib/routes";
import { ICON } from "../lib/icons";
const { lang } = Astro.props as { lang: Lang };
const pt = lang === "PT";
const L = (en: string, p: string) => (pt ? p : en);
const R = ROUTES[lang];

const types: [string, string, string, string][] = [
  ["website", L("Website", "Site"), L("Bilingual websites that load fast, rank in search and turn visits into enquiries — connected to your forms, CRM and analytics.", "Sites bilíngues, rápidos, bem posicionados nos buscadores e que transformam visitas em contatos — ligados aos seus formulários, CRM e métricas."), "website"],
  ["system", L("Management system", "Sistema de gestão"), L("The system your team runs the business on: clients, projects, bookings, finance, documents and reports — replacing spreadsheets and scattered e-mails.", "O sistema em que sua equipe toca o negócio: clientes, projetos, agendamentos, financeiro, documentos e relatórios — no lugar de planilhas e e-mails espalhados."), "dashboard"],
  ["app", L("Mobile app", "App"), L("iPhone and Android apps for your clients, staff or field teams, with notifications, documents, photos and sign-in by Face ID.", "Apps para iPhone e Android para clientes, equipe ou campo, com notificações, documentos, fotos e login por Face ID."), "phone"],
  ["portal", L("Client portal", "Portal do cliente"), L("A private space where each client follows requests, approves budgets, signs documents and pays invoices.", "Um espaço privado em que cada cliente acompanha pedidos, aprova orçamentos, assina documentos e paga faturas."), "portal"],
  ["whitelabel", L("White label", "White label"), L("Ready-made platforms delivered under your name, colours and domain — and your own app in the stores.", "Plataformas prontas entregues com o seu nome, cores e domínio — e com o seu próprio app nas lojas."), "whitelabel"],
];
const included: [string, string, string][] = [
  [L("Database and hosting", "Banco de dados e hospedagem"), L("Secure cloud hosting, daily backups and monitoring. Each client's data is kept separate from every other client's.", "Hospedagem segura em nuvem, backups diários e monitoramento. Os dados de cada cliente ficam separados dos demais."), "dashboard"],
  [L("Sign-in and roles", "Login e perfis"), L("Invitation-only access, e-mail confirmed before entry, 2-step verification and Face ID. Each role sees only what it should.", "Acesso só por convite, e-mail confirmado antes de entrar, verificação em duas etapas e Face ID. Cada perfil vê só o que deve."), "roles"],
  [L("Payments", "Pagamentos"), L("Subscriptions, invoices and card payments through Stripe — with automatic reminders when a payment fails.", "Assinaturas, faturas e pagamentos com cartão pelo Stripe — com lembretes automáticos quando um pagamento falha."), "payments"],
  [L("Your domain and brand", "Seu domínio e sua marca"), L("Your logo, colours and domain, with SSL. E-mails to your clients go out with your name.", "Seu logo, suas cores e seu domínio, com SSL. Os e-mails aos seus clientes saem com o seu nome."), "domain"],
  [L("Web, iPhone and Android", "Web, iPhone e Android"), L("The same system on the web and in apps for iOS and Android, published under your company.", "O mesmo sistema na web e em apps para iOS e Android, publicados em nome da sua empresa."), "phone"],
  [L("Secure sign-in", "Login seguro"), L("Google and Microsoft sign-in where you want it, single-use links and a full history of who accessed what.", "Login com Google e Microsoft quando quiser, links de uso único e histórico completo de quem acessou o quê."), "signin"],
];
const steps: [string, string][] = [
  [L("Brief", "Briefing"), L("We map your process, users and goals in one or two working sessions.", "Mapeamos seu processo, usuários e objetivos em uma ou duas reuniões.")],
  [L("Prototype", "Protótipo"), L("You see and click the main screens before anything is built.", "Você vê e clica nas telas principais antes de começarmos a construir.")],
  [L("Build", "Construção"), L("Short cycles with a working version to review every week.", "Ciclos curtos, com uma versão funcionando para revisar toda semana.")],
  [L("Launch", "Lançamento"), L("Your domain, app store publishing, user invitations and training.", "Seu domínio, publicação nas lojas, convite aos usuários e treinamento.")],
  [L("Support", "Suporte"), L("Monitoring, updates and improvements as your operation grows.", "Monitoramento, atualizações e melhorias conforme sua operação cresce.")],
];
const mods: [keyof typeof ICON, string, string][] = [
  ["people", L("Clients & sales (CRM)", "Clientes e vendas (CRM)"), L("Leads, clients, proposals, contracts and the full history of every relationship.", "Contatos, clientes, propostas, contratos e o histórico completo de cada relacionamento.")],
  ["plan", L("Operations & projects", "Operações e projetos"), L("Tasks, work orders and field teams with checklists, photos and deadlines.", "Tarefas, ordens de serviço e equipes de campo com checklists, fotos e prazos.")],
  ["bed", L("Bookings & scheduling", "Agendamentos e reservas"), L("Appointments, reservations, rooms, resources and calendars, with confirmations sent automatically.", "Consultas, reservas, salas, recursos e agendas, com confirmações enviadas automaticamente.")],
  ["money", L("Finance & billing", "Financeiro e cobrança"), L("Invoices, subscriptions, card payments, approvals and expense control.", "Faturas, assinaturas, pagamentos com cartão, aprovações e controle de despesas.")],
  ["home", L("Client & partner portals", "Portais de clientes e parceiros"), L("Each client, supplier or partner sees only their own requests, documents and invoices.", "Cada cliente, fornecedor ou parceiro vê só seus próprios pedidos, documentos e faturas.")],
  ["chart", L("Reports & dashboards", "Relatórios e painéis"), L("The numbers that matter to your business, updated in real time and exported in one click.", "Os números que importam para o seu negócio, atualizados em tempo real e exportados em um clique.")],
];
const sectors = pt
  ? ["Serviços profissionais", "Consultorias e escritórios", "Imóveis e condomínios", "Construção e engenharia", "Indústria", "Varejo e e-commerce", "Distribuição e atacado", "Restaurantes e alimentação", "Hotelaria e turismo", "Eventos", "Clínicas e saúde", "Bem-estar e academias", "Educação e treinamento", "Logística e transporte", "Agronegócio", "Energia, óleo e gás", "Tecnologia e startups", "ONGs e associações", "Realocação e mobilidade", "Franquias"]
  : ["Professional services", "Consultancies & firms", "Real estate & property", "Construction & engineering", "Manufacturing", "Retail & e-commerce", "Distribution & wholesale", "Restaurants & food", "Hospitality & tourism", "Events", "Clinics & healthcare", "Wellness & fitness", "Education & training", "Logistics & transport", "Agribusiness", "Energy, oil & gas", "Technology & startups", "Non-profits & associations", "Relocation & mobility", "Franchises"];
---
<Base lang={lang} page="technology" title={L("Connectas · Websites, systems and white-label apps", "Connectas · Sites, sistemas e apps white label")}
  description={L("Websites, management systems, client portals and iOS/Android apps — and a white-label platform for relocation and property companies, sold as a monthly subscription.", "Sites, sistemas de gestão, portais de cliente e apps iOS/Android — e uma plataforma white label para empresas de realocação e imóveis, por assinatura mensal.")}>

  <section class="hero2">
    <div class="wrap">
      <div class="hero2-top">
        <div>
          <span class="eyebrow fade-up" style="--d:100ms">{L("Connectas Technology", "Tecnologia Connectas")}</span>
          <h1><span class="mask-line"><span style="--d:150ms">{L("Software your business", "Software que o seu negócio")}</span></span><span class="mask-line"><span style="--d:300ms"><em>{L("actually runs on.", "usa de verdade.")}</em></span></span></h1>
        </div>
        <div class="hero2-side fade-up" style="--d:600ms">
          <p>{L("Websites, management systems, client portals and mobile apps — designed around how your company works, live on your domain, with sign-in, data and payments already in place.", "Sites, sistemas de gestão, portais de cliente e aplicativos — desenhados em torno de como sua empresa funciona, no seu domínio, com login, dados e pagamentos já resolvidos.")}</p>
          <div class="row"><a class="btn" href="#demo">{L("Talk about your project", "Converse sobre seu projeto")}<span class="arr">→</span></a><a class="link" href="#pricing">{L("Platform pricing", "Preços da plataforma")}</a></div>
        </div>
      </div>

      <div class="ttabs fade-up" style="--d:700ms" data-tabs>
        <div class="ttabs-bar" role="tablist" aria-label={L("Project types", "Tipos de projeto")}>
          {types.map(([k, t], i) => <button role="tab" type="button" id={`tab-${k}`} aria-controls={`panel-${k}`} aria-selected={i === 0 ? "true" : "false"} data-tab={k}>{t}</button>)}
        </div>
        {types.map(([k, , d, mock], i) => <div class="ttabs-panel" role="tabpanel" id={`panel-${k}`} aria-labelledby={`tab-${k}`} hidden={i !== 0}>
          <div class="ttabs-copy"><p>{d}</p></div>
          <div class="ttabs-mock"><Mock kind={mock} lang={lang} /></div>
        </div>)}
      </div>
    </div>
  </section>

  <section class="grey">
    <div class="wrap incl" data-incl>
      <div class="reveal">
        <span class="eyebrow">{L("Included", "Incluído")}</span>
        <h2>{L("Everything it needs,", "Tudo o que precisa,")} <em>{L("already in place.", "já resolvido.")}</em></h2>
        <p class="muted" style="max-width:520px">{L("No extra accounts to manage and no loose ends. Every project starts with these foundations.", "Sem contas extras para administrar e sem pontas soltas. Todo projeto já começa com esta base.")}</p>
        <ol class="incl-list">{included.map(([t, d], i) => <li><button type="button" data-incl-i={i} aria-expanded={i === 0 ? "true" : "false"}><span class="n">{String(i + 1).padStart(2, "0")}</span><span class="t">{t}</span></button><p hidden={i !== 0}>{d}</p></li>)}</ol>
      </div>
      <div class="incl-view reveal" style="--d:120ms">{included.map(([, , mock], i) => <div class="incl-pane" data-incl-p={i} hidden={i !== 0}><Mock kind={mock} lang={lang} /></div>)}</div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="reveal" style="margin-bottom:30px"><span class="eyebrow">{L("How we work", "Como trabalhamos")}</span><h2>{L("From idea to launch, in five steps.", "Da ideia ao lançamento, em cinco etapas.")}</h2></div>
      <ol class="timeline reveal" data-stagger>{steps.map(([t, d], i) => <li><span class="n">{String(i + 1).padStart(2, "0")}</span><div><h3>{t}</h3><p>{d}</p></div></li>)}</ol>
    </div>
  </section>

  <section class="grey">
    <div class="wrap">
      <div class="reveal" style="max-width:820px;margin-bottom:30px"><span class="eyebrow">{L("Our platform", "Nossa plataforma")}</span><h2>{L("Built from modules that fit any business.", "Feita de módulos que servem a qualquer negócio.")}</h2><p class="lead" style="font-size:18px">{L("Beyond custom projects, Connectas offers its own platform under your brand. Choose the modules you need and we adapt them to your sector.", "Além dos projetos sob medida, a Connectas oferece sua própria plataforma com a sua marca. Você escolhe os módulos e nós os adaptamos ao seu setor.")}</p></div>
      <div class="cards reveal" data-stagger>{mods.map(([ic, t, d]) => <div class="card"><span class="ic" set:html={ICON[ic]} /><h3>{t}</h3><p>{d}</p></div>)}</div>
      <span class="eyebrow reveal" style="margin-top:34px;display:block">{L("For companies of every sector", "Para empresas de todos os setores")}</span>
      <div class="tags reveal">{sectors.map((x) => <span>{x}</span>)}<span class="tag-open">{L("…and any business that wants to run better", "…e qualquer negócio que queira funcionar melhor")}</span></div>
    </div>
  </section>

  <section id="pricing" class="anchor">
    <div class="wrap">
      <div class="reveal" style="max-width:820px;margin-bottom:30px"><span class="eyebrow">{L("Pricing", "Preços")}</span><h2>{L("Projects by proposal. The platform by subscription.", "Projetos por proposta. A plataforma por assinatura.")}</h2><p class="lead" style="font-size:18px">{L("Websites, systems and apps are priced per project in a written proposal. The platform is a monthly subscription by module, in US dollars, always shown before you pay.", "Sites, sistemas e apps têm preço por projeto, em proposta escrita. A plataforma é uma assinatura mensal por módulo, em dólares, sempre exibida antes do pagamento.")}</p></div>
      <div class="price-grid reveal" data-stagger>
        <div class="price main"><span class="tag" style="color:#A8A8A8">{L("Required", "Obrigatório")}</span><h3>{L("Base subscription", "Assinatura base")}</h3><p>{L("Monthly fee plus an amount per active user or record, depending on the solution.", "Mensalidade mais um valor por usuário ou registro ativo, conforme a solução.")}</p>
          <ul><li>{L("Client and team portals, documents, messages", "Portais de clientes e equipe, documentos, mensagens")}</li><li>{L("Users, roles and audit log", "Usuários, perfis e registro de auditoria")}</li><li>{L("Your brand and domain", "Sua marca e seu domínio")}</li></ul></div>
        <div class="price"><span class="tag">{L("Optional", "Opcional")}</span><h3>{L("Add-on modules", "Módulos adicionais")}</h3><p>{L("Each module has its own monthly price.", "Cada módulo tem sua própria mensalidade.")}</p>
          <ul><li>{L("CRM · Operations · Bookings", "CRM · Operações · Agendamentos")}</li><li>{L("Finance & billing · Partner portals · Reports", "Financeiro e cobrança · Portais de parceiros · Relatórios")}</li><li>{L("SMS alerts and assistant requests, billed by use", "Alertas por SMS e pedidos ao assistente, cobrados por uso")}</li></ul></div>
        <div class="price"><span class="tag">{L("One-time + monthly", "Única + mensal")}</span><h3>{L("Your own app", "Seu próprio app")}</h3><p>{L("Setup fee plus a monthly fee to publish and maintain your branded apps in the App Store and Google Play.", "Taxa de implantação mais mensalidade para publicar e manter seus apps com a sua marca na App Store e no Google Play.")}</p></div>
      </div>
      <p class="fine reveal"><b>{L("How payment works.", "Como funciona o pagamento.")}</b> {L("Subscriptions are charged automatically every month to a credit or debit card. Card payments are processed by Stripe — card details never pass through our systems. Modules can be added from inside the platform and start right away. A free trial may be offered before the first payment. If a payment fails, the customer has 7 days to pay before access is paused; data is always kept. Any module, or the whole plan, can be cancelled from inside the platform with 30 days' notice — see our", "As assinaturas são cobradas automaticamente todo mês em cartão de crédito ou débito. Os pagamentos com cartão são processados pelo Stripe — os dados do cartão nunca passam pelos nossos sistemas. Módulos podem ser adicionados dentro da plataforma e começam na hora. Pode haver um período de teste gratuito antes do primeiro pagamento. Se um pagamento falhar, o cliente tem 7 dias para pagar antes de o acesso ser pausado; os dados são sempre mantidos. Qualquer módulo, ou o plano inteiro, pode ser cancelado dentro da plataforma com aviso prévio de 30 dias — veja a nossa")} <a href={R.refunds}>{L("Cancellation & Refund Policy", "Política de Cancelamento e Reembolso")}</a>. {L("A quote for your company is available on request.", "Fazemos um orçamento para a sua empresa sob consulta.")}</p>
    </div>
  </section>

  <section id="demo" class="sand anchor">
    <div class="wrap contact-grid">
      <div class="reveal"><span class="eyebrow">{L("Talk to us", "Fale com a gente")}</span><h2>{L("Tell us what you need to build.", "Conte o que você precisa construir.")}</h2><p class="lead">{L("A website, a system, an app or the platform with your brand — we reply within two business days with a first view of scope and timeline.", "Um site, um sistema, um app ou a plataforma com a sua marca — respondemos em até dois dias úteis com uma primeira visão de escopo e prazo.")}</p></div>
      <div class="reveal" style="--d:150ms"><ContactForm lang={lang} topic="tech" /></div>
    </div>
  </section>

  <script is:inline>
    (function () {
      function init() {
        document.querySelectorAll("[data-tabs]").forEach(function (box) {
          if (box.dataset.bound) return; box.dataset.bound = "1";
          box.addEventListener("click", function (e) {
            var b = e.target.closest("[data-tab]"); if (!b) return;
            box.querySelectorAll("[data-tab]").forEach(function (x) { x.setAttribute("aria-selected", String(x === b)); });
            box.querySelectorAll(".ttabs-panel").forEach(function (p) { p.hidden = p.id !== "panel-" + b.dataset.tab; });
          });
        });
        document.querySelectorAll("[data-incl]").forEach(function (box) {
          if (box.dataset.bound) return; box.dataset.bound = "1";
          box.addEventListener("click", function (e) {
            var b = e.target.closest("[data-incl-i]"); if (!b) return; var i = b.dataset.inclI;
            box.querySelectorAll("[data-incl-i]").forEach(function (x) { var on = x === b; x.setAttribute("aria-expanded", String(on)); x.nextElementSibling.hidden = !on; });
            box.querySelectorAll("[data-incl-p]").forEach(function (p) { p.hidden = p.dataset.inclP !== i; });
          });
        });
      }
      document.addEventListener("astro:page-load", init);
    })();
  </script>
</Base>
